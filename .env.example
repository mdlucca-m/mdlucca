# Copie para .env e ajuste. O arquivo .env não vai para o repositório.

# --- Endereço público -------------------------------------------------------
# Domínio próprio (lape.udesc.br) ou gratuito de DNS dinâmico (lape.duckdns.org).
# Só é usado no docker-compose.prod.yml, com o Caddy.
LAPE_DOMINIO=lape.duckdns.org

# Se a máquina não tem IP público, use o túnel do Cloudflare em vez do Caddy.
# Token gerado em one.dash.cloudflare.com → Networks → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Primeiro administrador -------------------------------------------------
# Criado sozinho na primeira subida. Depois disso pode apagar estas linhas.
LAPE_ADMIN_NAME=Alexandro Andrade
LAPE_ADMIN_LOGIN=andrade@udesc.br
# O serviço se recusa a subir com senha de exemplo. Gere uma:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
LAPE_ADMIN_PASSWORD=

# --- Publicação na internet -------------------------------------------------
# 1 marca o cookie de sessão como Secure. Ligue sempre que houver HTTPS na
# frente (Caddy ou túnel do Cloudflare). Sem isso o cookie viaja em claro.
LAPE_BEHIND_HTTPS=1

# 1 faz a aplicação ler o endereço real do visitante em X-Forwarded-For.
# Ligue SÓ quando houver mesmo um proxy na frente: sem proxy, esse cabeçalho é
# escrito pelo próprio cliente, e aceitá-lo daria a qualquer um a chave para
# escapar do travamento por tentativa e erro.
LAPE_TRUST_PROXY=1

# Travamento de força bruta (valores padrão; ajuste só se precisar).
# LAPE_LOCK_WINDOW_MIN=15
# LAPE_LOCK_AFTER_LOGIN=8
# LAPE_LOCK_AFTER_IP=25

# Duração da sessão, em dias.
# LAPE_SESSION_DAYS=14

# --- Automação (opcional, só se usar n8n) -----------------------------------
# Gere as duas com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# São diferentes de propósito: uma vale para entrar, a outra para provar que a
# mensagem saiu mesmo do LAPE.
LAPE_API_TOKEN=
LAPE_WEBHOOK_SECRET=

# --- Comportamento ----------------------------------------------------------
# 1 deixa o painel visível sem login (a área de cadastro continua protegida).
LAPE_PUBLIC_DASHBOARD=0

# E-mail de contato: Crossref e OpenAlex dão prioridade a quem se identifica.
LAPE_CONTACT_EMAIL=

# --- Bases proprietárias (opcionais) ----------------------------------------
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
WOS_API_KEY=
