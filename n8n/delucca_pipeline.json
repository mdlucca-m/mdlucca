{
  "name": "De Lucca — Análise Biomecânica (pipeline)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "analisar-video",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook (novo vídeo)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "delucca-analisar-video"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/pipeline/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video\": \"{{ $json.body.video }}\",\n  \"athlete\": \"{{ $json.body.athlete || 'Atleta' }}\",\n  \"exercise\": \"{{ $json.body.exercise || 'Video' }}\",\n  \"mass\": {{ $json.body.mass || 80 }},\n  \"legs3d\": {{ $json.body.legs3d || true }}\n}",
        "options": {}
      },
      "id": "http-run",
      "name": "Disparar pipeline (POST /pipeline/run)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 300]
    },
    {
      "parameters": {
        "amount": 90,
        "unit": "seconds"
      },
      "id": "wait-node",
      "name": "Aguardar processamento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [780, 300],
      "webhookId": "delucca-wait"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://host.docker.internal:8000/pipeline/jobs/{{ $node['Disparar pipeline (POST /pipeline/run)'].json.job_id }}",
        "options": {}
      },
      "id": "http-status",
      "name": "Consultar status (GET /pipeline/jobs/:id)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "running",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-running",
      "name": "Ainda rodando?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.manifest || $json) }}",
        "options": {}
      },
      "id": "respond",
      "name": "Responder com o manifest",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 400]
    }
  ],
  "connections": {
    "Webhook (novo vídeo)": { "main": [[{ "node": "Disparar pipeline (POST /pipeline/run)", "type": "main", "index": 0 }]] },
    "Disparar pipeline (POST /pipeline/run)": { "main": [[{ "node": "Aguardar processamento", "type": "main", "index": 0 }]] },
    "Aguardar processamento": { "main": [[{ "node": "Consultar status (GET /pipeline/jobs/:id)", "type": "main", "index": 0 }]] },
    "Consultar status (GET /pipeline/jobs/:id)": { "main": [[{ "node": "Ainda rodando?", "type": "main", "index": 0 }]] },
    "Ainda rodando?": {
      "main": [
        [{ "node": "Aguardar processamento", "type": "main", "index": 0 }],
        [{ "node": "Responder com o manifest", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true },
  "tags": [{ "name": "De Lucca Esporte" }]
}
