{
  "name": "LAPE — avisar publicação nova",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lape-evento",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "id": "lape-avisa",
      "name": "LAPE avisa",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ],
      "webhookId": "lape-evento"
    },
    {
      "parameters": {
        "jsCode": "// O LAPE assina o corpo com HMAC-SHA256 usando LAPE_WEBHOOK_SECRET.\n// Sem esta conferência, qualquer um poderia disparar o fluxo.\nconst crypto = require('crypto');\nconst segredo = $env.LAPE_WEBHOOK_SECRET;\nconst corpo = $input.first().json.body ?? '';\nconst bruto = typeof corpo === 'string' ? corpo : JSON.stringify(corpo);\nconst esperado = 'sha256=' + crypto.createHmac('sha256', segredo)\n  .update(bruto, 'utf8').digest('hex');\nconst recebido = $input.first().json.headers['x-lape-signature'];\nif (!recebido || recebido !== esperado) {\n  throw new Error('assinatura invalida — pedido descartado');\n}\nreturn [{ json: typeof corpo === 'string' ? JSON.parse(bruto) : corpo }];"
      },
      "id": "conferir-a-assinatura",
      "name": "Conferir a assinatura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.event }}",
              "rightValue": "artigo.publicado",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "é-publicação-nova?",
      "name": "É publicação nova?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $env.LAPE_SLACK_CANAL }}",
          "mode": "name"
        },
        "text": "=📄 *Nova publicação do LAPE*\n{{ $json.data.title }}\n{{ $json.data.journal }} · {{ $json.data.year }}\nhttps://doi.org/{{ $json.data.doi }}",
        "otherOptions": {}
      },
      "id": "anunciar-no-slack",
      "name": "Anunciar no Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "LAPE avisa": {
      "main": [
        [
          {
            "node": "Conferir a assinatura",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conferir a assinatura": {
      "main": [
        [
          {
            "node": "É publicação nova?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "É publicação nova?": {
      "main": [
        [
          {
            "node": "Anunciar no Slack",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "LAPE"
    }
  ]
}