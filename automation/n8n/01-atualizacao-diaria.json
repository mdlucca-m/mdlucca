{
  "name": "LAPE — atualização diária",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "id": "toda-madrugada",
      "name": "Toda madrugada",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LAPE_URL }}/api/hooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LAPE_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ acao: \"curador\", rastrear: false }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "rodar-o-curador",
      "name": "Rodar o curador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LAPE_URL }}/api/state",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.LAPE_API_TOKEN }}"
            }
          ]
        }
      },
      "id": "ver-o-que-ficou-pendente",
      "name": "Ver o que ficou pendente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.pending_discoveries }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "tem-achado-pendente?",
      "name": "Tem achado pendente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "subject": "=LAPE — {{ $json.pending_discoveries }} publicação(ões) para revisar",
        "toEmail": "={{ $env.LAPE_EMAIL_COORDENACAO }}",
        "text": "=O rastreador encontrou publicações novas.\n\nRevise em {{ $env.LAPE_URL }}/app#admin",
        "options": {}
      },
      "id": "avisar-a-coordenação",
      "name": "Avisar a coordenação",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        920,
        220
      ]
    }
  ],
  "connections": {
    "Toda madrugada": {
      "main": [
        [
          {
            "node": "Rodar o curador",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rodar o curador": {
      "main": [
        [
          {
            "node": "Ver o que ficou pendente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ver o que ficou pendente": {
      "main": [
        [
          {
            "node": "Tem achado pendente?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem achado pendente?": {
      "main": [
        [
          {
            "node": "Avisar a coordenação",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "LAPE"
    }
  ]
}